# =====================================================================
# 环境变量样例：复制成 .env 后填值。
#
#   cp .env.example .env          # .env 已在 .gitignore 里，不会被提交
#   docker compose up -d --build
#
# 这里只放**键名与说明**，不放任何真实密钥。生产密钥请用随机值，例如：
#   openssl rand -base64 48
# =====================================================================

# ---------- 必填：数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hazmat
DB_USERNAME=hazmat
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10

# ---------- 必填：JWT 签名密钥（至少 32 字节）----------
# 缺失或短于 32 字节时应用直接启动失败，见 SecurityConfig
HAZMAT_JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret
HAZMAT_TOKEN_TTL=8h

# ---------- 可选：演示种子账号的初始密码 ----------
# 仅在 hazmat.security.seed-users=true 时使用；prod profile 下该开关被强制为 false
HAZMAT_SEED_PASSWORD=ChangeMe123!

# ---------- 可选：Redis（缓存加速，不可用时自动降级查库）----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- 可选：模型调用 ----------
# 不开也行：向量由本地哈希兜底，/ask 返回抽取式片段
HAZMAT_AI_ENABLED=false
DASHSCOPE_API_KEY=
HAZMAT_CHAT_ENABLED=false
DEEPSEEK_API_KEY=

# ---------- 可选：向量存储 ----------
# memory（默认，进程内）或 pgvector（需同时启动 pgvector 服务）
HAZMAT_VECTOR_STORE=memory
# pgvector 演示参数；store=memory 时不会被读取
PG_VECTOR_DB=hazmat_vectors
PG_VECTOR_USER=hazmat
PG_VECTOR_PASSWORD=replace-with-a-strong-password
# 宿主机直接跑应用时用 localhost:5433；容器内由 compose 自动改成 pgvector:5432
# HAZMAT_PG_URL=jdbc:postgresql://localhost:5433/hazmat_vectors
HAZMAT_PG_DIMENSION=1024

# ---------- 可选：RabbitMQ（MSDS 编码任务队列）----------
# 全栈 compose 默认启用；设为 false 时编码回退到应用内单线程 executor。
# 只承载 MSDS 编码这一条旁路，库存、审批、出库、盘点、登录不进 MQ。
HAZMAT_MQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hazmat
RABBITMQ_PASSWORD=replace-with-a-strong-password

# ---------- 可选：接口文档 ----------
# 生产建议 false
SPRINGDOC_ENABLED=true
