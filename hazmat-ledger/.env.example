# =====================================================================
# 环境变量样例：复制成 .env 后填值。
#
#   cp .env.example .env          # .env 已在 .gitignore 里，不会被提交
#   docker compose up -d --build
#
# 这里只放**键名与说明**，不放任何真实密钥。生产密钥请用随机值，例如：
#   openssl rand -base64 48
# =====================================================================

# ---------- 必填：数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hazmat
DB_USERNAME=hazmat
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10

# ---------- 必填：JWT 签名密钥（至少 32 字节）----------
# 缺失或短于 32 字节时应用直接启动失败，见 SecurityConfig
HAZMAT_JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret
HAZMAT_TOKEN_TTL=8h

# ---------- 可选：演示种子账号的初始密码 ----------
# 仅在 hazmat.security.seed-users=true 时使用；prod profile 下该开关被强制为 false
HAZMAT_SEED_PASSWORD=ChangeMe123!

# ---------- 可选：Redis（缓存加速，不可用时自动降级查库）----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- 可选：模型调用 ----------
# 不开也行：向量由本地哈希兜底，/ask 返回抽取式片段
HAZMAT_AI_ENABLED=false
DASHSCOPE_API_KEY=
HAZMAT_CHAT_ENABLED=false
DEEPSEEK_API_KEY=

# ---------- 可选：向量存储 ----------
# memory（默认，进程内）或 pgvector（需同时启动 pgvector 服务）
HAZMAT_VECTOR_STORE=memory

# ---------- 可选：接口文档 ----------
# 生产建议 false
SPRINGDOC_ENABLED=true
